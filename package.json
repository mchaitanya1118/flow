{
  "name": "estateflow-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @estateflow/database db:generate",
    "db:push": "pnpm --filter @estateflow/database db:push",
    "db:seed": "pnpm --filter @estateflow/database db:seed",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.3",
    "prettier": "^3.5.1",
    "eslint": "^9.20.1"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.18",
      "@types/react-dom": "^18.3.5"
    }
  },
  "packageManager": "pnpm@10.33.0"
}
