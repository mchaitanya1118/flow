# EstateFlow Environment Variables

NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://estateflow:estateflow_password@localhost:5432/estateflow_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Search (OpenSearch)
OPENSEARCH_URL="http://localhost:9200"

# JWT / Auth
JWT_SECRET="estateflow-super-secret-jwt-key-change-in-production-2026"
NEXTAUTH_SECRET="estateflow-nextauth-secret-key-2026"
NEXTAUTH_URL="http://localhost:3000"

# Storage (AWS S3)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="mock_access_key"
AWS_SECRET_ACCESS_KEY="mock_secret_key"
S3_BUCKET="estateflow-media-storage"
CLOUDFRONT_URL="https://cdn.estateflow.io"

# Maps
NEXT_PUBLIC_MAP_PROVIDER="mapbox"
NEXT_PUBLIC_MAPBOX_TOKEN="pk.eyJ1IjoiZXN0YXRlZmxvdyIsImEiOiJjbGV4YW1wbGUxMjM0NTY3ODkwIn0.sample"

# Payments (Razorpay)
RAZORPAY_KEY_ID="rzp_test_EstateFlow12345"
RAZORPAY_KEY_SECRET="mock_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="mock_webhook_secret"

# Email (AWS SES)
SES_FROM_EMAIL="noreply@estateflow.io"

# Monitoring
SENTRY_DSN=""

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_SEARCH="true"
NEXT_PUBLIC_ENABLE_AI_ASSISTANT="true"
NEXT_PUBLIC_ENABLE_CHAT="true"
NEXT_PUBLIC_ENABLE_MORTGAGE="true"
